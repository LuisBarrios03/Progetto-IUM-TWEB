<!-- Including components in a layout (layout.hbs) -->
<!DOCTYPE html>
<html>
  <head>
      <meta charset="UTF-8">
      <title>{{title}}</title>
      <link rel='stylesheet' href='/stylesheets/style.css' />
      <!-- mettere link di bootstrap, javascript-->
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
      <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  </head>
  <body class="container-fluid p-0 m-0" onload="init()">
    <div>
      {{> navbar }}  <!-- Including the Navbar component &ndash-->
      {{#if showSearch}}
          {{> search}}
      {{/if}}

      <main>
          {{{body}}}
      </main>
        <div class="text-end m-3">
            <button class="btn btn-primary" onclick="scrollToTop()">Torna su</button>
        </div>
      {{> footer}}  <!-- Including the Footer component -->
      <script src="Js/index_layout.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </div>
  </body>
</html>
