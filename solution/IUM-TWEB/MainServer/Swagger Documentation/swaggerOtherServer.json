{
  "openapi": "3.0.0",
  "info": {
    "title": "Oscar API",
    "description": "API per la gestione dei dati sugli Oscar",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Server Oscar API"
    }
  ],
  "paths": {
    "/api/20dataOscar": {
      "get": {
        "summary": "Ottiene i dati Oscar",
        "responses": {
          "200": { "description": "Dati Oscar trovati" }
        }
      }
    },
    "/api/findOscar": {
      "get": {
        "summary": "Cerca un film vincitore di Oscar",
        "parameters": [
          {
            "name": "film",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Film Oscar trovato" }
        }
      }
    }
  }
}